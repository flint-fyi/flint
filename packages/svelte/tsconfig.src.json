{
	"extends": "@flint.fyi/build/tsconfig.plugin.json",
	"compilerOptions": {
		"tsBuildInfoFile": "node_modules/.cache/tsbuild/info.src.json",
		"rootDir": "src/",
		"outDir": "lib/",
		"types": []
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts", "src/rules/ruleTester.ts"],
	"references": [
		{ "path": "../core/tsconfig.src.json" },
		{ "path": "../svelte-language/tsconfig.src.json" },
		{ "path": "../ts/tsconfig.src.json" },
		{ "path": "../typescript-language/tsconfig.src.json" },
		{ "path": "../content-mapper/tsconfig.src.json" }
	]
}
