{
	"name": "@flint.fyi/typescript-language",
	"version": "0.21.1",
	"description": "[Experimental] TypeScript language for Flint.",
	"homepage": "https://flint.fyi",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flint-fyi/flint.git",
		"directory": "packages/typescript-language"
	},
	"license": "MIT",
	"author": {
		"name": "Flint Team",
		"url": "https://flint.fyi/team"
	},
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./native/ast": "./src/native/ast.ts",
		"./native/fs": "./src/native/fs.ts",
		"./native/path": "./src/native/path.ts",
		"./native/scanner": "./src/native/scanner.ts",
		"./native/sync": "./src/native/sync.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"generate:ast": "node scripts/generate-ast.ts",
		"test": "pnpm test:ast && vitest --project typescript-language",
		"test:ast": "pnpm generate:ast && git diff --exit-code -- src/types/ast.ts && tsc6 --project tsconfig.ast-test.json"
	},
	"dependencies": {
		"@flint.fyi/core": "workspace:^",
		"@flint.fyi/utils": "workspace:^",
		"cached-factory": "catalog:prod",
		"debug-for-file": "catalog:prod",
		"pathe": "catalog:prod",
		"typescript-native": "catalog:prod"
	},
	"devDependencies": {
		"@flint.fyi/build": "workspace:^",
		"prettier": "catalog:dev",
		"tsdown": "catalog:dev",
		"vitest": "catalog:dev"
	},
	"engines": {
		"node": ">=26.1.0"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.mjs",
			"./native/ast": "./dist/native/ast.mjs",
			"./native/fs": "./dist/native/fs.mjs",
			"./native/path": "./dist/native/path.mjs",
			"./native/scanner": "./dist/native/scanner.mjs",
			"./native/sync": "./dist/native/sync.mjs",
			"./package.json": "./package.json"
		}
	}
}
