{
	"name": "@flint.fyi/typescript-language",
	"version": "0.20.0",
	"description": "[Experimental] TypeScript language for Flint.",
	"homepage": "https://flint.fyi",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flint-fyi/flint.git",
		"directory": "packages/typescript-language"
	},
	"license": "MIT",
	"author": {
		"name": "Flint Team",
		"url": "https://flint.fyi/team"
	},
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"generate:ast": "node scripts/generate-ast.ts",
		"test": "pnpm test:ast && vitest --project typescript-language",
		"test:ast": "pnpm generate:ast && git diff --exit-code -- src/types/ast.ts && tsc --project tsconfig.ast-test.json"
	},
	"dependencies": {
		"@flint.fyi/core": "workspace:^",
		"@flint.fyi/utils": "workspace:^",
		"cached-factory": "^0.3.0",
		"debug-for-file": "^0.4.0",
		"pathe": "^2.0.3",
		"typescript-native": "catalog:dev"
	},
	"devDependencies": {
		"@flint.fyi/build": "workspace:^",
		"prettier": "catalog:dev",
		"tsdown": "catalog:dev",
		"vitest": "catalog:dev"
	},
	"engines": {
		"node": ">=26.1.0"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.mjs"
		}
	}
}
