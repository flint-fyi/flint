{
	"name": "@flint.fyi/astro-language",
	"version": "0.2.0",
	"description": "[Experimental] Astro language for Flint.",
	"homepage": "https://flint.fyi",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flint-fyi/flint.git",
		"directory": "packages/astro-language"
	},
	"license": "MIT",
	"author": {
		"name": "Flint Team",
		"url": "https://flint.fyi/team"
	},
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./content-mapper": "./src/content-mapper.ts"
	},
	"bin": {
		"astro-language": "./src/content-mapper.ts"
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"test": "vitest --project astro-language"
	},
	"dependencies": {
		"@astrojs/compiler": "^4.0.0",
		"@astrojs/ts-plugin": "^1.10.7",
		"@flint.fyi/content-mapper": "workspace:^",
		"@flint.fyi/core": "workspace:^",
		"@flint.fyi/typescript-language": "workspace:^",
		"@flint.fyi/utils": "workspace:^"
	},
	"devDependencies": {
		"@flint.fyi/build": "workspace:^",
		"tsdown": "catalog:dev",
		"vitest": "catalog:dev"
	},
	"engines": {
		"node": ">=26.1.0"
	},
	"publishConfig": {
		"access": "public",
		"bin": {
			"astro-language": "./dist/content-mapper.mjs"
		},
		"exports": {
			".": "./dist/index.mjs",
			"./content-mapper": "./dist/content-mapper.mjs"
		}
	},
	"typescript": {
		"contentMapper": {
			"exec": [
				"node",
				"./dist/content-mapper.mjs"
			],
			"compilerOptions": [
				"jsx",
				"module",
				"moduleResolution"
			]
		}
	}
}
