{
	"name": "@flint.fyi/package-json",
	"version": "0.21.1",
	"description": "[Experimental] package.json plugin for Flint.",
	"homepage": "https://flint.fyi/rules/package-json",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flint-fyi/flint.git",
		"directory": "packages/package-json"
	},
	"license": "MIT",
	"author": {
		"name": "Flint Team",
		"url": "https://flint.fyi/team"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"test": "vitest --project package-json"
	},
	"dependencies": {
		"@flint.fyi/core": "workspace:^",
		"@flint.fyi/json-language": "workspace:^",
		"@flint.fyi/utils": "workspace:^",
		"change-case": "catalog:prod",
		"detect-indent": "catalog:prod",
		"detect-newline": "catalog:prod",
		"package-json-validator": "catalog:prod",
		"sort-object-keys": "catalog:prod",
		"sort-package-json": "catalog:prod",
		"zod": "catalog:prod"
	},
	"devDependencies": {
		"@flint.fyi/build": "workspace:^",
		"@flint.fyi/rule-tester": "workspace:^",
		"@humanwhocodes/momoa": "catalog:dev",
		"tsdown": "catalog:dev",
		"typescript": "catalog:dev",
		"vitest": "catalog:dev"
	},
	"engines": {
		"node": ">=26.1.0"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.mjs"
		}
	}
}
