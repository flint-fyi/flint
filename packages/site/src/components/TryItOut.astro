---
import PackageManagers from "./PackageManagers.astro";
---

<section class="try-it-out" id="try-it-out">
	<div aria-hidden="true" class="sky"></div>
	<div aria-hidden="true" class="stars"></div>

	<div class="content">
		<p class="eyebrow">🏕️ Pitch your tent in 10 seconds</p>

		<h2 class="flint-display">Try Flint on any project</h2>

		<p class="lede">Pick your favorite fire-starter:</p>

		<div class="command">
			<PackageManagers type="dlx" pkg="flint" />
		</div>

		<p class="aside">
			Frustrated with slow linting that doesn't catch what you actually care
			about? Or maybe your linter is fast, but doesn't include powerful lint
			rules? Let Flint help you out. ☕
		</p>

		<a class="button" href="/about">Get started linting with Flint →</a>
	</div>
</section>

<style>
	.try-it-out {
		border: 2px solid var(--flint-paper-border);
		border-radius: 1.5rem;
		isolation: isolate;
		margin-block: 4rem;
		overflow: hidden;
		padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem);
		position: relative;
	}

	.sky {
		background: linear-gradient(
			180deg,
			var(--flint-band-top) 0%,
			var(--flint-band-bottom) 100%
		);
		inset: 0;
		position: absolute;
		z-index: -2;
	}

	.stars {
		background-image:
			radial-gradient(2px 2px at 20% 30%, white, transparent),
			radial-gradient(1px 1px at 60% 70%, white, transparent),
			radial-gradient(1.5px 1.5px at 80% 20%, white, transparent),
			radial-gradient(1px 1px at 30% 80%, white, transparent),
			radial-gradient(2px 2px at 90% 50%, white, transparent);
		inset: 0;
		opacity: var(--flint-band-stars);
		position: absolute;
		z-index: -1;
	}

	.content {
		margin-inline: auto;
		max-width: 42rem;
		text-align: center;
	}

	.eyebrow {
		color: var(--flint-band-eyebrow);
		font-size: var(--sl-text-sm);
		font-weight: 800;
		letter-spacing: 0.2em;
		margin: 0;
		text-transform: uppercase;
	}

	h2 {
		color: var(--flint-band-text);
		font-size: clamp(1.875rem, calc(1rem + 2.5vw), 2.75rem);
		margin: 0.75rem 0 0;
	}

	.lede {
		color: var(--flint-band-muted);
		font-size: var(--sl-text-lg);
		margin: 0.75rem 0 0;
	}

	.command {
		margin-block-start: 2rem;
		text-align: start;
	}

	.aside {
		color: var(--flint-band-muted);
		font-size: var(--sl-text-lg);
		font-style: italic;
		line-height: 1.6;
		margin: 2rem 0 0;
	}

	.button {
		background: var(--flint-ember-fill);
		border: 2px solid var(--flint-ember-fill);
		border-radius: 999px;
		color: var(--flint-ember-fill-text);
		display: inline-block;
		font-weight: 800;
		margin-block-start: 2rem;
		padding: 0.8rem 1.6rem;
		text-decoration: none;
		transition:
			box-shadow 150ms,
			transform 150ms;
	}

	.button:hover {
		box-shadow: var(--flint-glow);
		transform: translateY(-2px);
	}
</style>
