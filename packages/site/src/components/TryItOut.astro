---
import PackageManagers from "./PackageManagers.astro";
---

<section class="try-it-out not-content" id="try-it-out">
	<div class="content">
		<p class="eyebrow">🏕️ Get started in 10 seconds</p>

		<h2 class="flint-display">Try Flint on any project</h2>

		<p class="lede">Pick your favorite fire-starter:</p>

		<div class="command">
			<PackageManagers type="dlx" pkg="flint" />
		</div>

		<p class="aside">
			Frustrated with slow linting that doesn't catch what you care about? Or
			maybe your linter is fast, but doesn't lint everything you think it
			should? Give Flint a shot.
		</p>

		<a class="button" href="/about">Get started →</a>
	</div>
</section>

<style>
	.try-it-out {
		background: var(--flint-band-surface);
		border: 1px solid var(--flint-paper-border);
		border-radius: 0.75rem;
		margin-block: 1rem 4rem;
		padding: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 4vw, 3rem);
	}

	.content {
		margin-inline: auto;
		max-width: 42rem;
		text-align: center;
	}

	.eyebrow {
		color: var(--flint-band-eyebrow);
		font-size: var(--sl-text-xs);
		font-weight: 800;
		letter-spacing: 0.12em;
		margin: 0;
		text-transform: uppercase;
	}

	h2 {
		color: var(--flint-band-text);
		font-size: clamp(1.875rem, calc(1rem + 2.5vw), 2.75rem);
		line-height: 1.15;
		margin: 0.75rem 0 0;
	}

	.lede {
		color: var(--flint-band-muted);
		font-size: var(--sl-text-lg);
		margin: 0.75rem 0 0;
	}

	.command {
		margin-block-start: 1.5rem;
		text-align: start;
	}

	.command :global(.starlight-package-managers-tabs) {
		border-radius: 0.5rem;
	}

	.command :global([role="tab"]) {
		color: var(--flint-band-muted);
	}

	.command :global([role="tab"][aria-selected="true"]) {
		color: var(--flint-band-text);
	}

	@media (width < 30rem) {
		.command :global([role="tablist"]) {
			display: grid;
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}

		.command :global([role="tab"]) {
			justify-content: center;
			min-inline-size: 0;
			padding-inline: 0.25rem;
		}

		.command :global([role="tab"] svg) {
			display: none;
		}
	}

	@media (width >= 30rem) {
		.eyebrow {
			font-size: var(--sl-text-sm);
			letter-spacing: 0.2em;
		}
	}

	.aside {
		color: var(--flint-band-muted);
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		margin: 2rem 0 0;
	}

	.button {
		background: var(--flint-ember-fill);
		border: 1px solid var(--flint-ember-fill);
		border-radius: 0.5rem;
		color: var(--flint-ember-fill-text);
		display: inline-block;
		font-weight: 800;
		margin-block-start: 2rem;
		padding: 0.8rem 1.6rem;
		text-decoration: none;
		transition:
			background-color 150ms,
			border-color 150ms;
	}

	.button:hover {
		background: color-mix(
			in srgb,
			var(--flint-ember-fill) 88%,
			var(--flint-band-text)
		);
		border-color: transparent;
	}
</style>
