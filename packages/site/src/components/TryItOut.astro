<section class="try-it-out not-content" id="try-it-out">
	<div class="content">
		<h2 class="flint-display">Try Flint on any project</h2>

		<p class="aside">
			Frustrated with slow linting that doesn't catch what you care about? Or
			maybe your linter is fast, but doesn't lint everything you think it
			should? Give Flint a shot.
		</p>

		<div
			aria-label="Representative Flint CLI output"
			class="terminal"
			role="region"
		>
			{[
				["wide only-dark", darkCliOutput],
				["wide only-light", lightCliOutput],
				["narrow only-dark", darkNarrowCliOutput],
				["narrow only-light", lightNarrowCliOutput],
			].map(([className, code]) => (
				<div class={className}>
					<Code
						code={code}
						frame="terminal"
						lang="ansi"
						preserveIndent={false}
					/>
				</div>
			))}
		</div>

		<a class="button" href="/about/">
			Get started →
		</a>
	</div>
</section>

<style>
	.try-it-out {
		border-block-end: 1px solid var(--flint-paper-border);
		margin-block: 1rem 4rem;
		padding-block: clamp(3rem, 6vw, 4.5rem);
	}

	.content {
		display: grid;
		grid-template-areas:
			"heading"
			"aside"
			"terminal"
			"button";
		text-align: start;
	}

	h2 {
		color: var(--flint-band-text);
		font-size: clamp(1.875rem, calc(1rem + 2.5vw), 2.75rem);
		grid-area: heading;
		line-height: 1.15;
		margin: 0;
	}

