---
import { Code } from "@astrojs/starlight/components";

const darkCliOutput = [
	"$ flint",
	"\u001b[90mLinting with \u001b[36m\u001b[1mflint.config.ts\u001b[22m\u001b[39m\u001b[90m...\u001b[39m",
	"",
	"\u001b[4mfixtures/src/with-issues.ts\u001b[24m",
	"\u001b[90m  2:2\u001b[39m  Debugger statements should not be used in production code.  \u001b[33mts/debuggerStatements\u001b[39m",
	"",
	"\u001b[3m\u001b[31m✖ Found \u001b[1m1 report\u001b[22m across \u001b[1m1 file\u001b[22m.\u001b[39m\u001b[23m",
].join("\n");

const lightCliOutput = [
	"$ flint",
	"\u001b[38;2;120;120;120mLinting with \u001b[39m\u001b[38;2;0;122;204m\u001b[1mflint.config.ts\u001b[22m\u001b[39m\u001b[38;2;120;120;120m...\u001b[39m",
	"",
	"\u001b[38;2;0;0;0m\u001b[4mfixtures/src/with-issues.ts\u001b[24m\u001b[39m",
	"\u001b[38;2;120;120;120m  2:2\u001b[39m  \u001b[38;2;60;60;60mDebugger statements should not be used in production code.\u001b[39m  \u001b[38;2;170;0;0mts/debuggerStatements\u001b[39m",
	"",
	"\u001b[3m\u001b[38;2;170;0;0m✖ Found \u001b[1m1 report\u001b[22m across \u001b[1m1 file\u001b[22m.\u001b[39m\u001b[23m",
].join("\n");
---

<section class="try-it-out not-content" id="try-it-out">
	<div class="content">
		<h2 class="flint-display">Try Flint on any project</h2>

		<p class="aside">
			Frustrated with slow linting that doesn't catch what you care about? Or
			maybe your linter is fast, but doesn't lint everything you think it
			should? Give Flint a shot.
		</p>

		<div
			aria-label="Representative Flint CLI output"
			class="terminal"
			role="region"
		>
			<div class="only-dark">
				<Code
					code={darkCliOutput}
					frame="terminal"
					lang="ansi"
					preserveIndent={false}
					wrap
				/>
			</div>
			<div class="only-light">
				<Code
					code={lightCliOutput}
					frame="terminal"
					lang="ansi"
					preserveIndent={false}
					wrap
				/>
			</div>
		</div>

		<a class="button" href="/about">Get started →</a>
	</div>
</section>

<style>
	.try-it-out {
		border-block: 1px solid var(--flint-paper-border);
		margin-block: 1rem 4rem;
		padding-block: clamp(3rem, 6vw, 4.5rem);
	}

	.content {
		display: grid;
		grid-template-areas:
			"heading"
			"aside"
			"terminal"
			"button";
		text-align: start;
	}

	h2 {
		color: var(--flint-band-text);
		font-size: clamp(1.875rem, calc(1rem + 2.5vw), 2.75rem);
		grid-area: heading;
		line-height: 1.15;
		margin: 0;
	}

	.aside {
		color: var(--flint-band-muted);
		font-size: var(--sl-text-lg);
		grid-area: aside;
		line-height: 1.6;
		margin: 1rem 0 0;
		max-width: 42rem;
	}

	.terminal {
		grid-area: terminal;
		margin-block-start: 1.75rem;
		min-inline-size: 0;
	}

	.button {
		background: var(--flint-ember-fill);
		border: 1px solid var(--flint-ember-fill);
		border-radius: 0.5rem;
		color: var(--flint-ember-fill-text);
		display: inline-block;
		font-weight: 800;
		grid-area: button;
		justify-self: start;
		margin-block-start: 2rem;
		padding: 0.8rem 1.6rem;
		text-decoration: none;
		transition:
			background-color 150ms,
			filter 120ms ease-out;
	}

	.button:hover {
		filter: var(--flint-button-hover-filter);
	}

	.button:active {
		filter: var(--flint-button-pressed-filter);
		transition-duration: 0ms;
	}

	@media (width >= 50rem) {
		.content {
			column-gap: clamp(2.5rem, 5vw, 4rem);
			grid-template-areas:
				"heading terminal"
				"aside terminal"
				"button terminal";
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		}

		.terminal {
			align-self: center;
			margin-block-start: 0;
		}
	}
</style>
