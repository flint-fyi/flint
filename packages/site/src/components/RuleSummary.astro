---
import markdownIt from "markdown-it";

import { getPluginName, getRuleForPlugin } from "@flint.fyi/rule-data";

interface Props {
	plugin: string;
	rule: string;
}

const renderer = markdownIt();
const { plugin } = Astro.props;
const rule = getRuleForPlugin(plugin, Astro.props.rule);
---

<p class="lede" set:html={renderer.renderInline(rule.about.description)} />

<dl class="details">
	<dt>Plugin</dt>
	<dd>
		<a href={`/rules/${plugin}/`}>{getPluginName(plugin)}</a>
	</dd>
	{!!rule.about.presets?.length && (
		<>
			<dt>Presets</dt>
			<dd class="presets">
				{rule.about.presets.map((preset) => (
					<a
						class="flint-preset"
						data-preset={preset}
						href={`/rules/${plugin}/#${preset.toLowerCase()}`}
					>
						{preset}
					</a>
				))}
			</dd>
		</>
	)}
</dl>

<style>
	.lede {
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
	}

	.details {
		display: grid;
		font-size: var(--sl-text-sm);
		gap: 0.25rem 1.25rem;
		grid-template-columns: auto 1fr;

		& dt,
		& dd {
			margin: 0;
		}

		& dt {
			color: var(--sl-color-white);
			font-weight: 600;
		}
	}

	.presets {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}
</style>
