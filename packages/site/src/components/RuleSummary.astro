---
import markdownIt from "markdown-it";

import { getRuleAbout } from "@flint.fyi/rule-data";

interface Props {
	plugin: string;
	rule: string;
}

const renderer = markdownIt();
const about = getRuleAbout(Astro.props.plugin, Astro.props.rule);
---

<blockquote>
	<Fragment set:html={renderer.render(about.description)} />
</blockquote>

<blockquote>
	✅ This rule is included in the {Astro.props.plugin}{" "}
	{about.presets?.map((preset, i) => (
		<>
			{i !== 0 && " and "}
			<a href={`/rules/${Astro.props.plugin}/#${preset}`}>
				<code>{preset}</code>
			</a>
		</>
	))}{" "}
	preset{about.presets?.length ? "s" : ""}.
</blockquote>

<style>
	a {
		display: inline-block;
	}
</style>
