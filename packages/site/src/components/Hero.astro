---
import { LinkButton } from "@astrojs/starlight/components";
import { Image } from "astro:assets";

import InstallCommand from "./InstallCommand.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { actions = [], image, tagline, title = data.title } = data.hero ?? {};

const logo = image && "dark" in image ? image.dark : undefined;
const alt = image?.alt ?? "";
---

<div class="hero">
	<div class="copy">
		<h1 class="flint-display" data-page-title id="_top" set:html={title} />

		{tagline && <p class="tagline" set:html={tagline} />}

		<InstallCommand />

		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(
						({
							attrs: { class: className, ...attrs } = {},
							icon,
							link: href,
							text,
							variant,
						}) => (
							<LinkButton
								{href}
								{variant}
								icon={icon?.name}
								class:list={[className]}
								{...attrs}
							>
								{text}
							</LinkButton>
						),
					)}
				</div>
			)
		}
	</div>

	<div class="art">
		<div class="mark">
			{
				logo && (
					<Image
						alt={alt}
						height={200}
						loading="eager"
						src={logo}
						width={200}
					/>
				)
			}
		</div>
	</div>
</div>

<style>
	.hero {
		align-items: center;
		display: grid;
		gap: 2rem;
		grid-template-columns: 100%;
		padding-block: clamp(2.5rem, calc(2rem + 2vmin), 4rem);
	}

	.copy {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	h1 {
		color: var(--sl-color-white);
		line-height: 1.05;
		margin: 0;
		text-wrap: balance;
	}

	h1 :global(.hero-first-text) {
		font-size: clamp(3.75rem, 8vw, 6.25rem);
	}

	h1 :global(.hero-second) {
		color: var(--sl-color-accent);
		font-size: clamp(2.25rem, 4.5vw, 3.75rem);
	}

	h1 :global(.hero-third) {
		color: var(--sl-color-accent-high);
		font-size: clamp(2rem, 3.7vw, 3.25rem);
	}

	.tagline {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		line-height: 1.55;
		margin: 0;
		max-width: 42rem;
	}

	.actions {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.actions :global(a) {
		border-radius: 0.5rem;
		justify-content: center;
	}

	.art {
		display: grid;
		place-items: center;
	}

	.mark {
		display: grid;
		place-items: center;
	}

	.mark :global(img) {
		block-size: auto;
		inline-size: clamp(9rem, 14vw, 12.5rem);
		user-select: none;
	}

	@media (width >= 30rem) {
		.actions {
			flex-direction: row;
			flex-wrap: wrap;
		}

		.actions :global(a) {
			inline-size: auto;
		}
	}

	@media (width >= 50rem) {
		.hero {
			gap: clamp(3rem, 7vw, 7rem);
			grid-template-columns: minmax(0, 1fr) minmax(10rem, 13rem);
		}
	}
</style>
