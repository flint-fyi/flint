---
import { LinkButton } from "@astrojs/starlight/components";
import { Image } from "astro:assets";

import InstallCommand from "./InstallCommand.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { actions = [], image, tagline, title = data.title } = data.hero ?? {};

const logo = image && "dark" in image ? image.dark : undefined;
const alt = image?.alt ?? "";
---

<div class="hero">
	<div class="copy">
		<h1 class="flint-display" data-page-title id="_top" set:html={title} />

		{tagline && <p class="tagline" set:html={tagline} />}

		<InstallCommand />

		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(
						({
							attrs: { class: className, ...attrs } = {},
							icon,
							link: href,
							text,
							variant,
						}) => (
							<LinkButton
								{href}
								{variant}
								icon={icon?.name}
								class:list={[className]}
								{...attrs}
							>
								{text}
							</LinkButton>
						),
					)}
				</div>
			)
		}
	</div>

	<div class="art">
		<div class="mark">
			{
				logo && (
					<Image
						alt={alt}
						height={200}
						loading="eager"
						src={logo}
						width={200}
					/>
				)
			}
		</div>
	</div>
</div>

<style>
	.hero {
		align-items: flex-start;
		display: grid;
		gap: 3rem;
		grid-template-columns: 100%;
		padding-block: clamp(1.5rem, calc(0.5rem + 5vmin), 4rem);
	}

	.copy {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	h1 {
		color: var(--sl-color-white);
		font-size: clamp(2.125rem, calc(1rem + 4.5vw), 4rem);
		line-height: 1.05;
		margin: 0;
	}

	h1 :global(.hero-first-text) {
		font-size: calc(var(--sl-text-5xl) * 2);
	}

	h1 :global(.hero-second) {
		color: var(--sl-color-accent);
		font-size: calc(var(--sl-text-5xl) * 1.1);
	}

	h1 :global(.hero-third) {
		color: var(--sl-color-accent-high);
		font-size: var(--sl-text-5xl);
	}

	.tagline {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		margin: 0;
		max-width: 40rem;
	}

	.actions {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.actions :global(a) {
		justify-content: center;
	}

	.art {
		display: grid;
		place-items: center;
	}

	.mark {
		display: grid;
		padding-inline-start: clamp(0.5rem, 2vw, 1.5rem);
		place-items: center;
	}

	.mark :global(img) {
		block-size: auto;
		user-select: none;
	}

	@media (width >= 30rem) {
		.actions {
			flex-direction: row;
			flex-wrap: wrap;
		}

		.actions :global(a) {
			inline-size: auto;
		}
	}

	@media (width >= 50rem) {
		.hero {
			grid-template-columns: 10fr 3fr;
			padding-block: clamp(2rem, calc(1rem + 8vmin), 6rem);
		}
	}
</style>
