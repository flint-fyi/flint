---
import Default from "@astrojs/starlight/components/Pagination.astro";
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import { Image } from "astro:assets";

export type Props = StarlightRouteData;

const isHomepage = Astro.url.pathname === "/";
---

{!isHomepage && <Default {...Astro.props} />}

<div class:list={["credits", { homepage: isHomepage }]}>
	Made with ❤️‍🔥 around the world by <a href="/project/team/">the Flint team</a>{" "}
	and{" "}
	<a href="http://github.com/flint-fyi/flint/contributors" target="_blank">
		contributors
	</a>
	.
</div>

{isHomepage && (
	<a class="netlify" href="https://www.netlify.com">
		<Image
			alt="Deploys by Netlify"
			class="dark"
			height={50}
			src="https://www.netlify.com/assets/badges/netlify-badge-color-accent.svg"
			width={114}
		/>
		<Image
			alt="Deploys by Netlify"
			class="light"
			height={50}
			src="https://www.netlify.com/assets/badges/netlify-badge-color-bg.svg"
			width={114}
		/>
	</a>
)}

<style>
	.credits {
		border-top: 1px solid var(--sl-color-gray-6);
		color: var(--sl-color-gray-3);
		margin-top: clamp(2rem, calc(0.25rem + 6vw), 5rem);
		padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem) 0 2rem;
		text-align: center;
	}

	.credits.homepage {
		border-block-start: 0;
		margin-block-start: 0;
		padding-block: 1rem 0.5rem;
	}

	.credits a {
		color: var(--sl-color-gray-2);
	}

	.netlify {
		display: block;
		margin-inline: auto;
		inline-size: fit-content;
	}

	:global(footer:has(.credits.homepage) .meta:empty) {
		display: none;
	}

	:global(html[data-theme="dark"]) .light,
	:global(html[data-theme="light"]) .dark {
		display: none;
	}
</style>
