---
import markdownIt from "markdown-it";

import { getRuleForPlugin } from "@flint.fyi/rule-data";

const renderer = markdownIt();

const ruleIds = [
	"anyAssignments",
	"unnecessaryComparisons",
	"deprecated",
	"caseFallthroughs",
	"arrayIncludes",
	"unnecessaryTernaries",
];

const rules = ruleIds.map((ruleId) => {
	const { about } = getRuleForPlugin("ts", ruleId);

	return {
		description: renderer.renderInline(about.description),
		id: ruleId,
		preset: about.presets?.[0] ?? "none",
	};
});
---

<section class="trail-map flint-paper not-content" id="rules">
	<div class="copy">
		<h2 class="flint-display">Hundreds of rules, hand-picked & happy.</h2>
		<p class="lede">
			Each rule comes with a friendly explanation, real-world examples, and an
			autofix when we can manage it. No cryptic codes. No lecture from the
			scout-master.
		</p>
		<div class="actions">
			<a class="button primary" href="/rules">Browse rules</a>
			<a class="button" href="/about">Read the docs</a>
		</div>
	</div>

	<ul class="rules">
		{
			rules.map((rule) => (
				<li class="rule">
					<div class="rule-heading">
						<a href={`/rules/ts/${rule.id}`}>ts/{rule.id}</a>
						<span class="preset" data-preset={rule.preset}>
							{rule.preset}
						</span>
					</div>
					<p set:html={rule.description} />
				</li>
			))
		}
	</ul>
</section>

<style>
	.trail-map {
		border-block: 1px solid var(--flint-paper-border);
		display: grid;
		gap: 2rem;
		grid-template-columns: 100%;
		padding: clamp(2.5rem, 5vw, 4rem) clamp(0rem, 3vw, 2rem);
	}

	h2 {
		color: var(--sl-color-white);
		font-size: clamp(1.75rem, calc(1rem + 2vw), 2.25rem);
		line-height: 1.15;
		margin: 0;
		text-wrap: balance;
	}

	.lede {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		margin: 1rem 0 0;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block-start: 1.5rem;
	}

	.button {
		border: 1px solid var(--flint-paper-border);
		border-radius: 0.5rem;
		color: var(--sl-color-white);
		flex: 1 1 auto;
		font-weight: 700;
		padding: 0.7rem 1.4rem;
		text-align: center;
		text-decoration: none;
		transition:
			background-color 150ms,
			border-color 150ms,
			color 150ms;
	}

	.button.primary {
		background: var(--flint-ember-fill);
		border-color: var(--flint-ember-fill);
		color: var(--flint-ember-fill-text);
	}

	.button:hover {
		border-color: var(--sl-color-gray-3);
	}

	.button.primary:hover {
		background: color-mix(
			in srgb,
			var(--flint-ember-fill) 88%,
			var(--sl-color-white)
		);
		border-color: transparent;
	}

	.rules {
		display: grid;
		gap: 0.5rem;
		grid-template-columns: 100%;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.rule {
		background: var(--sl-color-black);
		border: 1px solid var(--flint-paper-border);
		border-radius: 0.5rem;
		display: flex;
		flex-direction: column;
		padding: 0.8rem 0.9rem;
	}

	.rule-heading {
		align-items: baseline;
		display: flex;
		gap: 0.4rem;
		white-space: nowrap;
	}

	.rule a {
		color: var(--sl-color-white);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	.rule p {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		margin: 0.35rem 0 0;
	}

	.rule p :global(code) {
		background: var(--flint-badge-surface);
		border-radius: 0.25rem;
		color: var(--flint-badge-text);
		font-size: 0.95em;
		padding: 0.05rem 0.25rem;
	}

	.preset {
		border-radius: 0.25rem;
		display: inline-block;
		font-family: var(--sl-font-mono);
		font-size: 0.68rem;
		font-weight: 800;
		padding: 0.1rem 0.35rem;
	}

	.preset[data-preset="logical"] {
		background: var(--flint-badge-surface);
		color: var(--flint-badge-text);
	}

	.preset[data-preset="stylistic"] {
		background: color-mix(in srgb, var(--flint-moss) 25%, transparent);
		color: var(--sl-color-white);
	}

	@media (width >= 50rem) {
		.trail-map {
			grid-template-columns: 0.85fr 1.55fr;
		}

		.rules {
			grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		}
	}
</style>
