---
import logo from "~/assets/logo.svg";
import { Image } from "astro:assets";
---

<section class="gather" id="campfire">
	<Image
		alt="The Flint logo: a flaming heart atop a squiggly underline"
		height={120}
		src={logo}
		width={120}
	/>

	<h2 class="flint-display">Gather 'round, friend.</h2>

	<p>
		Flint is built in the open by a tiny crew who really, really like good code
		and warm drinks. Come hang out.
	</p>

	<div class="actions">
		<a class="button pine" href="/discord">💬 Join the Discord</a>
		<a class="button" href="/blog">📰 Read the blog</a>
	</div>
</section>

<style>
	.gather {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
		padding-block: 4rem;
		text-align: center;
	}

	.gather :global(img) {
		block-size: auto;
		inline-size: 6rem;
	}

	h2 {
		color: var(--sl-color-white);
		font-size: clamp(1.875rem, calc(1rem + 2.5vw), 2.75rem);
		margin: 0;
	}

	.gather p {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		margin: 0;
		max-width: 34rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		margin-block-start: 1rem;
	}

	.button {
		background: var(--flint-paper);
		border: 2px solid var(--flint-paper-border);
		border-radius: 999px;
		color: var(--sl-color-white);
		font-weight: 700;
		padding: 0.7rem 1.4rem;
		text-decoration: none;
		transition: transform 150ms;
	}

	.button.pine {
		background: var(--flint-pine);
		border-color: var(--flint-pine-mark);
		color: var(--flint-cream);
	}

	.button:hover {
		transform: translateY(-2px);
	}
</style>
