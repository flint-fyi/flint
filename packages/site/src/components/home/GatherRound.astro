---
import { LinkButton } from "@astrojs/starlight/components";
import logo from "~/assets/logo.svg";
import { Image } from "astro:assets";
---

<section class="gather not-content" id="campfire">
	<Image
		alt="The Flint logo: a flaming heart atop a squiggly underline"
		height={120}
		src={logo}
		width={120}
	/>

	<h2 class="flint-display">Gather ’round, friend.</h2>

	<p>
		Flint is built in the open by a tiny crew who really, really like cool code
		and warm drinks. Come hang out.
	</p>

	<div class="actions">
		<LinkButton href="/discord/" icon="discord" iconPlacement="start">
			Join our Discord
		</LinkButton>
		<LinkButton
			href="/blog/"
			icon="rss"
			iconPlacement="start"
			variant="secondary"
		>
			Read our blog
		</LinkButton>
	</div>
</section>

<style>
	.gather {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
		padding-block: 3rem;
		text-align: center;
	}

	.gather :global(img) {
		block-size: auto;
		inline-size: 6rem;
	}

	h2 {
		color: var(--sl-color-white);
		font-size: clamp(1.875rem, calc(1rem + 2.5vw), 2.75rem);
		line-height: 1.15;
		margin: 0;
	}

	.gather p {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		margin: 0;
		max-width: 30rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		margin-block-start: 1rem;
	}
</style>
