---
import { Icon } from "@astrojs/starlight/components";

const features = [
	{
		body: "Flint ships with a sensible set of rules turned on, so you can start linting without writing a pile of config first.",
		accent: "ember",
		icon: "heart",
		title: "Toasty by default",
	},
	{
		body: "Change one file and Flint re-checks that file and its dependents. Everything else comes straight from the cache.",
		accent: "moss",
		icon: "rocket",
		title: "No wasted trips",
	},
	{
		body: "Flint’s rules can use the full TypeScript type checker, so they catch bugs that syntax-only linters miss.",
		accent: "lake",
		icon: "star",
		title: "Sheltered by types",
	},
	{
		body: "Flint configs are plain, readable TypeScript that scales with your project.",
		accent: "berry",
		icon: "document",
		title: "Config you can read",
	},
] as const;
---

<section class="pack not-content" id="features">
	<div class="intro">
		<h2 class="flint-display">Everything you need to guide you</h2>
		<p class="lede">
			Flint learns from years of web tooling to be your new North Star for
			lovely linting.
		</p>
	</div>

	<div class="grid">
		{features.map((feature) => (
			<article class="flint-paper feature" data-accent={feature.accent}>
				<div class="icon">
					<Icon name={feature.icon} size="2rem" />
				</div>
				<div class="body">
					<h3 class="flint-display">{feature.title}</h3>
					<p>{feature.body}</p>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.pack {
		padding-block: 3rem;
	}

	.intro {
		margin-inline: auto;
		max-width: 48rem;
		text-align: center;
	}

	.intro h2 {
		color: var(--sl-color-white);
		font-size: clamp(1.875rem, calc(1rem + 2.5vw), 2.75rem);
		line-height: 1.15;
		margin: 0;
		text-wrap: balance;
	}

	.lede {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		margin: 1rem 0 0;
	}

	.grid {
		display: grid;
		gap: 2.5rem 3rem;
		grid-template-columns: 100%;
		margin-block-start: 2.5rem;
	}

	.feature {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-block-start: 1.5rem;
	}

	.feature[data-accent="ember"] {
		--feature-bg: var(--flint-tag-ember-bg);
		--feature-fg: var(--flint-tag-ember-fg);
	}

	.feature[data-accent="moss"] {
		--feature-bg: var(--flint-tag-moss-bg);
		--feature-fg: var(--flint-tag-moss-fg);
	}

	.feature[data-accent="lake"] {
		--feature-bg: var(--flint-tag-lake-bg);
		--feature-fg: var(--flint-tag-lake-fg);
	}

	.feature[data-accent="berry"] {
		--feature-bg: var(--flint-tag-berry-bg);
		--feature-fg: var(--flint-tag-berry-fg);
	}

	.icon {
		align-items: center;
		background: var(--feature-bg);
		block-size: 3.5rem;
		border-radius: 0.5rem;
		color: var(--feature-fg);
		display: flex;
		flex-shrink: 0;
		inline-size: 3.5rem;
		justify-content: center;
	}

	.body {
		align-items: flex-start;
		display: flex;
		flex: 1;
		flex-direction: column;
	}

	h3 {
		color: var(--sl-color-white);
		font-size: var(--sl-text-2xl);
		line-height: 1.2;
		margin: 0;
	}

	.feature p {
		color: var(--sl-color-gray-2);
		line-height: 1.6;
		margin: 0.5rem 0 0;
	}

	@media (width >= 30rem) {
		.feature {
			flex-direction: row;
			gap: 1.25rem;
		}
	}

	@media (width >= 50rem) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
