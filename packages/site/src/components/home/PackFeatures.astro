---
import { Icon } from "@astrojs/starlight/components";

const features = [
	{
		body: "Sensible rules right out of the bag. No config wrangling — just unzip, light the fire, and start linting.",
		icon: "heart",
		title: "Toasty by default",
	},
	{
		body: "Intelligent caching and CI coordination keep duplicate jobs from wandering off-trail. Your runs finish faster.",
		icon: "rocket",
		title: "Always points home",
	},
	{
		body: "Lint rules powered by the full TypeScript type checker. They catch the kind of bugs that hide under tent flaps.",
		icon: "star",
		title: "Type-checked shelter",
	},
	{
		body: "Configs you can actually read by lantern-light. Powerful when you need it, quiet when you don't.",
		icon: "document",
		title: "Bright, readable config",
	},
] as const;
---

<section class="pack not-content" id="features">
	<div class="intro">
		<h2 class="flint-display">Everything you need to guide you</h2>
		<p class="lede">
			Flint learns from years of web tooling to be your new North Star for
			lovely linting.
		</p>
	</div>

	<div class="grid">
		{features.map((feature) => (
			<article class="flint-paper feature">
				<div class="icon">
					<Icon name={feature.icon} size="2rem" />
				</div>
				<div class="body">
					<h3 class="flint-display">{feature.title}</h3>
					<p>{feature.body}</p>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.pack {
		padding-block: 3rem;
	}

	.intro {
		margin-inline: auto;
		max-width: 48rem;
		text-align: center;
	}

	.intro h2 {
		color: var(--sl-color-white);
		font-size: clamp(1.875rem, calc(1rem + 2.5vw), 2.75rem);
		line-height: 1.15;
		margin: 0;
		text-wrap: balance;
	}

	.lede {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		margin: 1rem 0 0;
	}

	.grid {
		display: grid;
		gap: 2.5rem 3rem;
		grid-template-columns: 100%;
		margin-block-start: 2.5rem;
	}

	.feature {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-block-start: 1.5rem;
	}

	.icon {
		align-items: center;
		background: var(--sl-color-accent-low);
		block-size: 3.5rem;
		border-radius: 0.5rem;
		color: var(--sl-color-accent);
		display: flex;
		flex-shrink: 0;
		inline-size: 3.5rem;
		justify-content: center;
	}

	.body {
		align-items: flex-start;
		display: flex;
		flex: 1;
		flex-direction: column;
	}

	h3 {
		color: var(--sl-color-white);
		font-size: var(--sl-text-2xl);
		line-height: 1.2;
		margin: 0;
	}

	.feature p {
		color: var(--sl-color-gray-2);
		line-height: 1.6;
		margin: 0.5rem 0 0;
	}

	@media (width >= 30rem) {
		.feature {
			flex-direction: row;
			gap: 1.25rem;
		}
	}

	@media (width >= 50rem) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
