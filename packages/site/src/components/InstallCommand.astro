---
import PackageManagers from "./PackageManagers.astro";
import { packageManagers } from "./packageManagers.ts";

const defaultCommand = "npm i -D flint";
const defaultPackageManager = "npm";
---

<div class="install-command not-content" data-install-command>
	<label class="package-manager">
		<span
			aria-hidden="true"
			class="package-manager-icon"
			data-package-manager-icon></span>
		<select aria-label="Package manager" data-package-manager>
			{
				packageManagers.map((packageManager) => (
					<option
						selected={packageManager === defaultPackageManager}
						value={packageManager}
					>
						{packageManager}
					</option>
				))
			}
		</select>
	</label>
	<code data-install-output>{defaultCommand}</code>
	<button
		aria-label={`Copy ${defaultPackageManager} install command`}
		class="copy-button"
		data-command={defaultCommand}
		data-copy-install
		type="button"
	>
		<span aria-hidden="true" class="copy-icon"></span>
		<span aria-hidden="true" class="check-icon"></span>
	</button>

	<div data-command-sources hidden>
		{
			packageManagers.map((packageManager) => (
				<div data-command-source={packageManager}>
					<PackageManagers
						dev
						frame="none"
						icons={false}
						pkg="flint"
						pkgManagers={[packageManager]}
						type="add"
					/>
				</div>
			))
		}
	</div>

	<div data-package-manager-icons hidden>
		<PackageManagers
			dev
			frame="none"
			pkg="flint"
			pkgManagers={packageManagers}
			type="add"
		/>
	</div>
</div>

<script>
	async function copyToClipboard(value: string): Promise<boolean> {
		const clipboardWrite = navigator.clipboard?.writeText(value);
		const textarea = document.createElement("textarea");
		textarea.value = value;
		textarea.setAttribute("readonly", "");
		textarea.style.position = "fixed";
		textarea.style.opacity = "0";
		document.body.append(textarea);
		textarea.select();

		const copied = (
			document as unknown as {
				execCommand(commandId: "copy"): boolean;
			}
		).execCommand("copy");
		textarea.remove();

		if (copied) {
			void clipboardWrite?.catch(() => undefined);
			return true;
		}

		try {
			await clipboardWrite;
			return clipboardWrite !== undefined;
		} catch {
			return false;
		}
	}

	document
		.querySelectorAll<HTMLElement>("[data-install-command]")
		.forEach((container) => {
			const button = container.querySelector<HTMLButtonElement>(
				"[data-copy-install]",
			);
			const output = container.querySelector<HTMLElement>(
				"[data-install-output]",
			);
			const select = container.querySelector<HTMLSelectElement>(
				"[data-package-manager]",
			);
			const iconOutput = container.querySelector<HTMLElement>(
				"[data-package-manager-icon]",
			);
			if (!button || !output || !select || !iconOutput) {
				return;
			}
			const installElements = { button, iconOutput, output, select };

			const commands = new Map<string, string>();
			container
				.querySelectorAll<HTMLElement>("[data-command-source]")
				.forEach((source) => {
					const packageManager = source.dataset.commandSource;
					const command = source.querySelector("code")?.textContent?.trim();
					if (packageManager && command) {
						commands.set(packageManager, command);
					}
				});
			const icons = new Map<string, SVGElement>();
			container
				.querySelectorAll<HTMLElement>(
					"[data-package-manager-icons] [role='tab']",
				)
				.forEach((tab) => {
					const packageManager = tab.textContent?.trim();
					const icon = tab.querySelector("svg");
					if (packageManager && icon) {
						icons.set(packageManager, icon);
					}
				});

			let resetTimer: number | undefined;

			function resetCopyState(): void {
				delete installElements.button.dataset.copied;
				installElements.button.setAttribute(
					"aria-label",
					`Copy ${installElements.select.value} install command`,
				);
			}

			function updateSelection(): void {
				const command = commands.get(installElements.select.value);
				if (!command) {
					return;
				}

				installElements.output.textContent = command;
				installElements.button.dataset.command = command;
				installElements.iconOutput.replaceChildren();
				const icon = icons.get(installElements.select.value);
				if (icon) {
					installElements.iconOutput.append(icon.cloneNode(true));
				}
			}

			updateSelection();

			installElements.select.addEventListener("change", () => {
				if (resetTimer !== undefined) {
					window.clearTimeout(resetTimer);
					resetTimer = undefined;
				}

				updateSelection();
				resetCopyState();
			});

			installElements.button.addEventListener("click", async () => {
				const command = installElements.button.dataset.command;
				if (!command) {
					return;
				}

				if (!(await copyToClipboard(command))) {
					return;
				}

				installElements.button.dataset.copied = "true";
				installElements.button.setAttribute(
					"aria-label",
					`Copied ${installElements.select.value} install command`,
				);

				resetTimer = window.setTimeout(() => {
					resetCopyState();
					resetTimer = undefined;
				}, 2000);
			});
		});
</script>

<style>
	.install-command {
		align-items: stretch;
		background: var(--flint-paper);
		border: 1px solid var(--flint-paper-border);
		border-radius: 0.5rem;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) 2.5rem;
		inline-size: min(100%, 25.5rem);
		overflow: hidden;
	}

	code,
	.copy-button {
		align-items: center;
		display: flex;
	}

	.package-manager {
		background: var(--flint-badge-surface);
		border-inline-end: 1px solid var(--flint-paper-border);
		color: var(--flint-badge-text);
		display: grid;
		grid-template-columns: 1rem minmax(0, 1fr);
		gap: 0.35rem;
		padding-inline-start: 0.625rem;
		position: relative;
	}

	.package-manager-icon {
		align-items: center;
		display: flex;
		inline-size: 1rem;
		justify-content: center;
	}

	.package-manager-icon :global(svg) {
		block-size: 1rem;
		inline-size: 1rem;
	}

	.package-manager::after {
		block-size: 0.4rem;
		border-block-end: 1px solid currentColor;
		border-inline-end: 1px solid currentColor;
		content: "";
		inline-size: 0.4rem;
		pointer-events: none;
		position: absolute;
		inset-inline-end: 0.55rem;
		inset-block-start: calc(50% - 0.3rem);
		rotate: 45deg;
	}

	select {
		appearance: none;
		background: transparent;
		block-size: 100%;
		border: 0;
		color: inherit;
		cursor: pointer;
		font-family: var(--sl-font);
		font-size: var(--sl-text-xs);
		font-weight: 700;
		inline-size: 4rem;
		padding: 0 1.25rem 0 0;
	}

	select:focus-visible {
		outline: 2px solid var(--sl-color-accent-high);
		outline-offset: -3px;
	}

	code {
		background: transparent;
		color: var(--sl-color-white);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		min-block-size: 2.5rem;
		overflow-x: auto;
		padding-inline: 0.875rem;
		white-space: nowrap;
	}

	.copy-button {
		background: transparent;
		border: 0;
		border-inline-start: 1px solid var(--flint-paper-border);
		color: var(--sl-color-gray-2);
		cursor: pointer;
		justify-content: center;
		padding: 0;
		position: relative;
		transition:
			background-color 150ms,
			color 150ms,
			filter 120ms ease-out;
	}

	.copy-button:hover,
	.copy-button[data-copied="true"] {
		background: var(--flint-badge-surface);
		color: var(--flint-badge-text);
	}

	.copy-button:hover {
		filter: var(--flint-button-hover-filter);
	}

	.copy-button:active {
		filter: var(--flint-button-pressed-filter);
		transition-duration: 0ms;
	}

	.copy-button:focus-visible {
		outline: 2px solid var(--sl-color-accent-high);
		outline-offset: -3px;
	}

	.copy-icon,
	.check-icon {
		background: currentColor;
		block-size: 1.125rem;
		inline-size: 1.125rem;
		mask-position: center;
		mask-repeat: no-repeat;
		mask-size: contain;
		position: absolute;
		transition:
			opacity 150ms,
			transform 150ms;
	}

	.copy-icon {
		mask-image: url("/icons/copy.svg");
	}

	.check-icon {
		mask-image: url("/icons/check.svg");
		opacity: 0;
		transform: scale(0.75);
	}

	.copy-button[data-copied="true"] .copy-icon {
		opacity: 0;
		transform: scale(0.75);
	}

	.copy-button[data-copied="true"] .check-icon {
		opacity: 1;
		transform: scale(1);
	}

	@media (width < 30rem) {
		code {
			padding-inline: 0.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.copy-button,
		.copy-icon,
		.check-icon {
			transition: none;
		}
	}
</style>
