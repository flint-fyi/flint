{
	"name": "flint",
	"version": "0.19.2",
	"description": "[Experimental] A fast, friendly linter. ❤️‍🔥",
	"homepage": "https://flint.fyi",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flint-fyi/flint.git",
		"directory": "packages/flint"
	},
	"license": "MIT",
	"author": {
		"name": "Flint Team",
		"url": "https://flint.fyi/team"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"flint": "./src/bin/index.ts"
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"test": "vitest --project flint"
	},
	"dependencies": {
		"@flint.fyi/cli": "workspace:",
		"@flint.fyi/core": "workspace:",
		"@flint.fyi/json": "workspace:",
		"@flint.fyi/md": "workspace:",
		"@flint.fyi/package-json": "workspace:",
		"@flint.fyi/ts": "workspace:",
		"@flint.fyi/ts-patch": "workspace:",
		"@flint.fyi/yaml": "workspace:",
		"typescript": "catalog:prod"
	},
	"devDependencies": {
		"@flint.fyi/build": "workspace:^",
		"prettier": "catalog:dev",
		"tsdown": "catalog:dev"
	},
	"peerDependencies": {
		"prettier": "catalog:peer"
	},
	"engines": {
		"node": ">=26.1.0"
	},
	"publishConfig": {
		"bin": {
			"flint": "./dist/bin/index.mjs"
		},
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	}
}
