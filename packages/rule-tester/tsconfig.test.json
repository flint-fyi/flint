{
	"extends": "@flint.fyi/build/tsconfig.base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "node_modules/.cache/tsbuild/info.test.json",
		"isolatedDeclarations": true,
		"rootDir": "src/",
		"outDir": "node_modules/.cache/tsbuild/test",
		"types": ["node"]
	},
	"include": ["src/**/*.test.ts"],
	"references": [{ "path": "./tsconfig.src.json" }]
}
