	"dependencies": {
		"@flint.fyi/core": "workspace:^",
		"@flint.fyi/typescript-language": "workspace:^",
		"@flint.fyi/utils": "workspace:^",
		"@flint.fyi/vue-language": "workspace:^",
		"scslre": "^0.3.0",
		"ts-api-utils": "^2.4.0",
		"typescript": "^5.9.0 || ^6.0.0"
	},
	"devDependencies": {
		"@flint.fyi/rule-tester": "workspace:^",
		"tsdown": "0.20.1",
		"vitest": "4.0.15",
		"vue": "~3.5.27"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
