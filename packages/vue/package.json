{
	"name": "@flint.fyi/vue",
	"version": "0.4.1",
	"description": "[Experimental] Vue.js language plugin for Flint.",
	"homepage": "https://flint.fyi/rules/vue",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flint-fyi/flint.git",
		"directory": "packages/vue"
	},
	"license": "MIT",
	"author": {
		"name": "Flint Team",
		"url": "https://flint.fyi/team"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./content-mapper": "./src/content-mapper.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"test": "vitest --project vue"
	},
	"dependencies": {
		"@flint.fyi/content-mapper": "workspace:^",
		"@flint.fyi/core": "workspace:^",
		"@flint.fyi/ts": "workspace:^",
		"@flint.fyi/vue-language": "workspace:^",
		"@vue/compiler-dom": "catalog:prod",
		"typescript-native": "catalog:prod"
	},
	"devDependencies": {
		"@flint.fyi/build": "workspace:^",
		"@flint.fyi/rule-tester": "workspace:^",
		"@flint.fyi/typescript-language": "workspace:^",
		"tsdown": "catalog:dev",
		"vitest": "catalog:dev",
		"vue": "catalog:dev"
	},
	"engines": {
		"node": ">=26.1.0"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.mjs",
			"./content-mapper": "./dist/content-mapper.mjs",
			"./package.json": "./package.json"
		}
	},
	"typescript": {
		"contentMapper": {
			"exec": [
				"node",
				"./dist/content-mapper.mjs"
			],
			"compilerOptions": [
				"noUnusedLocals"
			]
		}
	}
}
