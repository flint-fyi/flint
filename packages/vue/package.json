{
	"name": "@flint.fyi/vue",
	"version": "0.0.1",
	"description": "[Experimental] Vue.js language plugin for Flint.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flint-fyi/flint.git",
		"directory": "packages/vue"
	},
	"license": "MIT",
	"author": {
		"name": "JoshuaKGoldberg",
		"email": "npm@joshuakgoldberg.com"
	},
	"sideEffects": false,
