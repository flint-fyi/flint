{
	"name": "@flint.fyi/ts-patch",
	"version": "0.14.0",
	"description": "[Experimental] Utilities for patching TypeScript used by @flint/core.",
	"homepage": "https://flint.fyi",
	"repository": {
		"type": "git",
		"url": "https://github.com/flint-fyi/flint",
		"directory": "packages/ts-patch"
	},
	"license": "MIT",
	"author": {
		"name": "Flint Team",
		"url": "https://flint.fyi/team"
	},
	"sideEffects": [
		"./dist/install-patch-hooks.js",
		"./dist/install-patch.js",
		"./dist/proxy-program.js",
		"./dist/shared.js"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./install-patch": "./src/install-patch.ts",
		"./install-patch-hooks": "./src/install-patch-hooks.ts"
	},
	"files": [
		"dist/"
	],
	"devDependencies": {
		"@flint.fyi/build": "workspace:^",
		"tsdown": "catalog:dev",
		"typescript": "catalog:dev"
	},
	"peerDependencies": {
		"typescript": "^6.0.0"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"./install-patch": "./dist/install-patch.mjs",
			"./install-patch-hooks": "./dist/install-patch-hooks.mjs"
		}
	}
}
